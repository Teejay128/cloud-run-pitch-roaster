# Server port (Cloud Run injects PORT automatically)
PORT=8080

# Option A: Vertex AI via Application Default Credentials / Cloud Run Service Account
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Option B: Gemini Developer API key (leave both unset for zero-config mock mode)
GEMINI_API_KEY=

# Gemini model ID used by @google/genai
GEMINI_MODEL=gemini-3.8-flash

# AI evaluator persona (override across Cloud Run revisions for canary traffic splitting)
AI_PERSONA=ruthless but witty Silicon Valley VC

# Automatically injected by Cloud Run; defaults to "local-dev" locally
# K_REVISION=local-dev
